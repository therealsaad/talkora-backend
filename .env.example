NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/talkora?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000

AI_PROVIDER=qwen
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=50000
TTS_TIMEOUT_MS=300000
STT_TIMEOUT_MS=120000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
TTS_MODEL=ai4bharat/indic-parler-tts
TTS_VOICE=Priya
TTS_STYLE_VERSION=talkora-priya-v6-indian-kids-teacher
STT_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.6-27b
CONVERSATION_GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=diana
GROQ_TTS_VOCAL_PREFIX=[warm, gentle, cheerful Indian English teacher voice]
CONVERSATION_VOICE_PROVIDER=groq
INDICF5_SERVICE_URL=
OPENAI_API_KEY=

# Voice providers: mock | kokoro | sarvam
VOICE_PROVIDER=python
SARVAM_API_KEY=
